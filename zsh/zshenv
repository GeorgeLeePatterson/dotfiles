# Every Zsh process reads this file. Keep startup quiet; never unlock a Keychain.
export LANG=${LANG:-en_US.UTF-8}
export XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-$HOME/.config}
export XDG_DATA_HOME=${XDG_DATA_HOME:-$HOME/.local/share}
export XDG_STATE_HOME=${XDG_STATE_HOME:-$HOME/.local/state}
export EDITOR=micro
export VISUAL=$EDITOR
export PAGER=less
export BAT_PAGER='less -RF'
export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION:-us-east-1}
export RUST_BACKTRACE=${RUST_BACKTRACE:-full}
export PNPM_HOME="$HOME/.local/share/pnpm"
export BUN_INSTALL="$HOME/.bun"
typeset -U path
# Both Intel and Apple Silicon, plus existing tools installed outside Homebrew.
path=("$HOME/.local/bin" /opt/homebrew/bin /opt/homebrew/sbin /usr/local/bin
      /opt/homebrew/opt/libpq/bin /usr/local/opt/libpq/bin
      "$HOME/.cargo/bin" "$PNPM_HOME" "$BUN_INSTALL/bin" "$HOME/.docker/bin"
      "$HOME/.lmstudio/bin" "$HOME/go/bin" $path)
# Docker Desktop's CLI remains discoverable before its first-launch symlinks.
path+=(/Applications/Docker.app/Contents/Resources/bin
        "$HOME/Applications/Docker.app/Contents/Resources/bin")
# NVM also initializes in SSH/agent shells. Its normal startup preserves an
# inherited NVM version, otherwise selecting the configured default quietly.
export NVM_DIR="$HOME/.nvm"
# Terminal apps can retain fnm's old environment even after it is uninstalled.
# Retire only its runtime paths, then let NVM choose/preserve the Node version.
() {
  local entry name
  local -a retained
  for entry in "${path[@]}"; do
    case "$entry" in
      "$HOME/.fnm"|"$HOME/.fnm/"*|"$HOME/.local/share/fnm"|"$HOME/.local/share/fnm/"*|\
      "$HOME/Library/Application Support/fnm"|"$HOME/Library/Application Support/fnm/"*|\
      */fnm_multishells/*) continue ;;
    esac
    retained+=("$entry")
  done
  path=("${retained[@]}")
  for name in ${(k)parameters}; do
    [[ $name != FNM_* ]] || unset "$name"
  done
}
[[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh"
[[ -r "$HOME/.zshenv.local" ]] && source "$HOME/.zshenv.local"
# GUI-launched agents commonly use noninteractive Zsh and skip .zshrc. Load
# the same everyday groups there; interactive shells load after local overrides.
if [[ ! -o interactive && ${DOTFILES_KEYCHAIN_AUTOLOAD:-1} != 0 ]] &&
   (( $+commands[dotfiles-credentials] )); then
  eval "$(command dotfiles-credentials shell-env)"
fi
